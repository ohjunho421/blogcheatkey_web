option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: application
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: /var/app/staging/blog_cheatkey/backend
    DJANGO_SETTINGS_MODULE: blog_cheatkey.settings
  aws:elasticbeanstalk:environment:
    InstanceProfile: aws-elasticbeanstalk-ec2-role

commands:
  01_install_dependencies:
    command: pip install -r /var/app/staging/requirements.txt

container_commands:
  00_debug:
    command: "pwd && ls -al && tree"
    cwd: .

  01_migrate:
    command: "python manage.py migrate"
    cwd: /var/app/staging/blog_cheatkey
    leader_only: true

  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    cwd: /var/app/staging/blog_cheatkey
    leader_only: true