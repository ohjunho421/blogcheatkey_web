option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: application
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: /var/app/staging/blog_cheatkey
    DJANGO_SETTINGS_MODULE: backend.blog_cheatkey.settings
    
# commands:
#   01_install_dependencies:
#     command: pip install -r /var/app/staging/requirements.txt

container_commands:
  00_install_deps:
    command: "pip install -r requirements.txt"
    cwd: /var/app/staging

  01_migrate:
    command: "python manage.py migrate"
    cwd: /var/app/staging/blog_cheatkey
    leader_only: true

  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    cwd: /var/app/staging/blog_cheatkey
    leader_only: true
