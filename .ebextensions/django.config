option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: application
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: /var/app/staging/blog_cheatkey/backend
    DJANGO_SETTINGS_MODULE: blog_cheatkey.settings

