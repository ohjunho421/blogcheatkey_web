container_commands:
  00_install_dependencies:
    command: "pip install -r requirements.txt"
    leader_only: true

  01_migrate:
    command: "python manage.py migrate"
    cwd: blog_cheatkey
    leader_only: true

  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    cwd: blog_cheatkey
    leader_only: true